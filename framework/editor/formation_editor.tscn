anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.11, 0.12, 0.16, 1)

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
