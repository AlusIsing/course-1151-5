theme_override_font_sizes/font_size = 14
text = "近戰（戰士、坦克）打敵方最前排、刺客打最後排，都優先打同一行；射手打任何一格；法師打同一行全部；補師治療相鄰隊友；坦克替相鄰隊友分擔傷害"
autowrap_mode = 3
